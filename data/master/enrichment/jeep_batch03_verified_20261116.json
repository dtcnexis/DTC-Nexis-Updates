  "diagnostics": [
    {
      "procedure_id": "COMPASS_M7_IDCM",
      "scope": "2020 Compass M7 EYG EMEA",
      "source_id": "jeep_src_2021_idcm_m7",
      "steps_ar": [
        "سجل رموز وأعطال IDCM واختبر أهلية VIN والنشرة",
        "افحص وجود DTC خارج النشرة أولاً",
        "إذا انطبقت النشرة استخدم wiTECH لدعم فلاش IDCM؛ بطارية 12V أثناء الفلاش 13.2 إلى 13.5 فولت فقط",
        "أعد قراءة الأخطاء بعد البرمجة"
      ],
      "live_data": [
        "DTC status",
        "IDCM calibration level"
      ],
      "live_data_numeric_thresholds": "غير مؤكد"
    },
    {
      "procedure_id": "WRANGLER_JL_IDCM",
      "scope": "2022 JL ECX, build 03-01 to 05-13 NA/IAP/CH",
      "source_id": "jeep_src_2023_idcm_jl",
      "steps_ar": [
        "تأكد من VIN ونطاق التصنيع وأعراض عدم شحن السيارة",
        "تحقق من حالة B22A9-87 الفعلي",
        "اتبع إجراء High-Voltage Power Down فقط بواسطة فني مؤهل وبمعدات الوقاية",
        "فحص/استبدال IDCM إذا انطبقت شروط الوثيقة ثم High-Voltage Power Up وامسح الأكواد"
      ],
      "live_data_numeric_thresholds": "غير مؤكد"
    },
    {
      "procedure_id": "ERC_DFT_TCM",
      "scope": "2022-2024 JL ERC/DFT and 2022 JT ERC/DFT",
      "source_ids": [
        "jeep_src_2025_tcm_jl22",
        "jeep_src_2025_tcm_jl23",
        "jeep_src_2025_tcm_jl24",
        "jeep_src_2025_tcm_jt22"
      ],
      "steps_ar": [
        "سجل أكواد TCM وأعراض MIL/حرارة زيت ناقل الحركة",
        "تحقق من VIN وERC وDFT ومن معايرة الوحدة",
        "شخص الأكواد الأخرى وفق مكتبة المصنع قبل الفلاش",
        "طبّق تحديث TCM باستخدام wiTECH ومصدر كهربائي مستقر حسب تعليمات المصنع",
        "امسح الأكواد وتحقق من زوال العطل دون افتراض تلف محول العزم"
      ],
      "live_data": [
